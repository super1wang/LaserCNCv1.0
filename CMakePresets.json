{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-ninja",
      "hidden": true,
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build",
      "cacheVariables": {
        "LCNC_WITH_ACS": "ON",
        "LCNC_WITH_GTN": "ON",
        "LCNC_WITH_BDAQ": "OFF",
        "LCNC_WITH_REAL_LASER": "OFF"
      }
    },
    {
      "name": "all-off",
      "displayName": "All device SDKs off",
      "inherits": "base-ninja"
      ,"cacheVariables": {
        "LCNC_WITH_ACS": "OFF",
        "LCNC_WITH_GTN": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "ACS + GTN with MSVC AddressSanitizer",
      "inherits": "base-ninja",
      "cacheVariables": {
        "LCNC_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "acs",
      "displayName": "ACS adapter only",
      "inherits": "base-ninja",
      "cacheVariables": {
        "LCNC_WITH_ACS": "ON",
        "LCNC_WITH_GTN": "OFF"
      }
    },
    {
      "name": "gtn",
      "displayName": "GTN adapter only",
      "inherits": "base-ninja",
      "cacheVariables": {
        "LCNC_WITH_ACS": "OFF",
        "LCNC_WITH_GTN": "ON"
      }
    },
    {
      "name": "acs-gtn",
      "displayName": "Debug with ACS and GTN adapters",
      "inherits": "base-ninja",
      "cacheVariables": {
        "LCNC_WITH_ACS": "ON",
        "LCNC_WITH_GTN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug-all-off",
      "configurePreset": "all-off",
      "configuration": "Debug"
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "Debug"
    },
    {
      "name": "acs",
      "configurePreset": "acs",
      "configuration": "Debug"
    },
    {
      "name": "gtn",
      "configurePreset": "gtn",
      "configuration": "Debug"
    },
    {
      "name": "acs-gtn-debug",
      "configurePreset": "acs-gtn",
      "configuration": "Debug"
    },
    {
      "name": "acs-gtn-release",
      "configurePreset": "acs-gtn",
      "configuration": "Release"
    }
  ]
}
