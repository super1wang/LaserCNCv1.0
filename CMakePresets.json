{
  "version": 6,
  "cmakeMinimumRequired": {
    "major": 3,
    "minor": 20,
    "patch": 0
  },
  "configurePresets": [
    {
      "name": "base-config",
      "hidden": true,
      "cacheVariables": {
        "LCNC_WITH_ACS": "ON",
        "LCNC_WITH_GTN": "ON",
        "LCNC_WITH_BDAQ": "OFF",
        "LCNC_WITH_REAL_LASER": "OFF"
      }
    },
    {
      "name": "base-ninja",
      "hidden": true,
      "inherits": "base-config",
      "generator": "Ninja Multi-Config",
      "binaryDir": "${sourceDir}/build-cmake"
    },
    {
      "name": "base-vs",
      "hidden": true,
      "inherits": "base-config",
      "generator": "Visual Studio 17 2022",
      "architecture": "x64",
      "binaryDir": "${sourceDir}/build-vs"
    },
    {
      "name": "all-off",
      "displayName": "All device SDKs off",
      "inherits": "base-ninja",
      "binaryDir": "${sourceDir}/build-cmake-all-off",
      "cacheVariables": {
        "LCNC_WITH_ACS": "OFF",
        "LCNC_WITH_GTN": "OFF"
      }
    },
    {
      "name": "asan",
      "displayName": "ACS + GTN with MSVC AddressSanitizer",
      "inherits": "base-ninja",
      "binaryDir": "${sourceDir}/build-cmake-asan",
      "cacheVariables": {
        "LCNC_ENABLE_ASAN": "ON"
      }
    },
    {
      "name": "acs",
      "displayName": "ACS adapter only",
      "inherits": "base-ninja",
      "binaryDir": "${sourceDir}/build-cmake-acs",
      "cacheVariables": {
        "LCNC_WITH_ACS": "ON",
        "LCNC_WITH_GTN": "OFF"
      }
    },
    {
      "name": "gtn",
      "displayName": "GTN adapter only",
      "inherits": "base-ninja",
      "binaryDir": "${sourceDir}/build-cmake-gtn",
      "cacheVariables": {
        "LCNC_WITH_ACS": "OFF",
        "LCNC_WITH_GTN": "ON"
      }
    },
    {
      "name": "real-laser",
      "displayName": "ACS + GTN with real laser adapters",
      "inherits": "base-ninja",
      "binaryDir": "${sourceDir}/build-cmake-real-laser",
      "cacheVariables": {
        "LCNC_WITH_REAL_LASER": "ON"
      }
    },
    {
      "name": "quality",
      "displayName": "ACS + GTN closure warnings gate",
      "inherits": "base-ninja",
      "binaryDir": "${sourceDir}/build-cmake-quality",
      "cacheVariables": {
        "LCNC_WARNINGS_AS_ERRORS": "ON"
      }
    },
    {
      "name": "acs-gtn",
      "displayName": "CMake/Ninja with ACS and GTN adapters",
      "inherits": "base-ninja",
      "cacheVariables": {
        "LCNC_WITH_ACS": "ON",
        "LCNC_WITH_GTN": "ON"
      }
    },
    {
      "name": "vs-acs-gtn",
      "displayName": "Visual Studio solution with ACS and GTN adapters",
      "inherits": "base-vs",
      "cacheVariables": {
        "LCNC_WITH_ACS": "ON",
        "LCNC_WITH_GTN": "ON"
      }
    }
  ],
  "buildPresets": [
    {
      "name": "debug-all-off",
      "configurePreset": "all-off",
      "configuration": "Debug"
    },
    {
      "name": "asan",
      "configurePreset": "asan",
      "configuration": "Debug"
    },
    {
      "name": "acs",
      "configurePreset": "acs",
      "configuration": "Debug"
    },
    {
      "name": "gtn",
      "configurePreset": "gtn",
      "configuration": "Debug"
    },
    {
      "name": "real-laser",
      "configurePreset": "real-laser",
      "configuration": "Debug"
    },
    {
      "name": "quality",
      "configurePreset": "quality",
      "configuration": "Debug"
    },
    {
      "name": "acs-gtn-debug",
      "configurePreset": "acs-gtn",
      "configuration": "Debug"
    },
    {
      "name": "acs-gtn-release",
      "configurePreset": "acs-gtn",
      "configuration": "Release"
    },
    {
      "name": "vs-acs-gtn-debug",
      "configurePreset": "vs-acs-gtn",
      "configuration": "Debug"
    },
    {
      "name": "vs-acs-gtn-release",
      "configurePreset": "vs-acs-gtn",
      "configuration": "Release"
    }
  ]
}
