{
  "version": "0.2.0",
  "configurations": [
    {
      // F5 只走一条链路：先执行 preLaunchTask，再启动 VS2022 生成的 Debug 可执行文件。
      // 不再通过 cmake.launchTargetPath 让 CMake Tools 额外触发一次 build。
      "name": "Debug LaserCNC",
      "type": "cppvsdbg",
      "request": "launch",
      "program": "${workspaceFolder}/cmake-build-sdkcheck/Debug/LaserCNC.exe",
      "args": [],
      "stopAtEntry": false,
      "cwd": "${workspaceFolder}/cmake-build-sdkcheck/Debug",
      "environment": [],
      "console": "integratedTerminal",
      "preLaunchTask": "CMake: build"
    }
  ]
}
