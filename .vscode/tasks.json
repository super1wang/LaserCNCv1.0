{
  "version": "2.0.0",
  "tasks": [
    {
      // 给 launch.json 的 preLaunchTask 用，保留这个标签名避免改动调试配置引用。
      // 实际改为直接调用 VS2022 的 MSBuild，稳定构建 cmake-build-sdkcheck 下的解决方案。
      "label": "CMake: build",
      "type": "shell",
      "command": "E:/vs2022IDE/MSBuild/Current/Bin/MSBuild.exe",
      "args": [
        "${workspaceFolder}/cmake-build-sdkcheck/LaserCNC.sln",
        "/t:LaserCNC",
        "/p:Configuration=Debug",
        "/p:Platform=x64",
        "/m",
        "/nologo"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}
