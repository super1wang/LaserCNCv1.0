{
  "version": "2.0.0",
  "tasks": [
    {
      // 与 CMake Tools 使用同一 Ninja 构建目录，避免调用不存在或过期的 .sln。
      "label": "CMake: build",
      "type": "shell",
      "command": "cmake",
      "args": [
        "--build",
        "${workspaceFolder}/cmake-build-sdkcheck",
        "--parallel",
        "16"
      ],
      "group": {
        "kind": "build",
        "isDefault": true
      },
      "problemMatcher": "$msCompile",
      "presentation": {
        "reveal": "silent",
        "panel": "shared"
      }
    }
  ]
}
