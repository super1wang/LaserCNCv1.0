{
  // Use the Visual Studio 17 2022 (MSBuild) generator with MSVC 14.44 from
  // E:\vs2022IDE — matches the toolchain Qt 6.9.1 msvc2022_64 and OCC vc144
  // were built with. Do NOT use the VS18 Insiders kit / Ninja generator: that
  // pairs MSVC 14.51 with VS2022-built Qt/OCC and crashes at startup (ABI
  // mismatch). cmake-kits.json defines the only kit (VS 2022 x64); pick it via
  // the status bar so `CMake: Configure` does not fall back to a global kit.
  // Command-line build (no vcvars) works because MSBuild brings its own env.
  "cmake.buildDirectory": "${workspaceFolder}/cmake-build-sdkcheck",
  "cmake.parallelJobs": 16,
  "cmake.buildBeforeRun": false,
  "cmake.debugConfig": {
    "console": "integratedTerminal",
    "cwd": "${workspaceFolder}/cmake-build-sdkcheck/Debug"
  }
}